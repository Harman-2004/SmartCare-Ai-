<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Base application theme. -->
    <style name="Theme.SmartCare" parent="Theme.AppCompat.DayNight.NoActionBar">
        <!-- Primary brand color attributes -->
        <item name="colorPrimary">@color/cyan_accent</item>
        <item name="colorPrimaryDark">@color/bg_dark</item>
        <item name="colorAccent">@color/blue_accent</item>
        
        <!-- Status bar styling -->
        <item name="android:statusBarColor">@color/bg_dark</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/bg_dark</item>
    </style>

    <!-- Fullscreen style for splash activity -->
    <style name="Theme.SmartCare.Fullscreen" parent="Theme.SmartCare">
        <item name="android:windowFullscreen">true</item>
        <item name="android:windowContentOverlay">@null</item>
    </style>

    <!-- Theme for configuration dark forms -->
    <style name="Theme.SmartCare.DarkForm" parent="Theme.SmartCare">
        <!-- Input field styling variables -->
        <item name="android:windowBackground">@color/bg_dark</item>
        <item name="android:editTextColor">@color/text_primary_dark</item>
        <item name="android:textColorHint">@color/text_secondary_dark</item>
    </style>
</resources>
